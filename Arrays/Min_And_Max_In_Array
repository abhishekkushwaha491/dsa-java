class Solution {
    public ArrayList<Integer> getMinMax(int[] arr) {
        int max = arr[0];
        int min = arr[0];
        
        for(int i=1;i<arr.length;i++){
            max = Math.max(max,arr[i]);
            min = Math.min(min,arr[i]);
        }
        
        ArrayList<Integer> result = new ArrayList<>();
        
        
        result.add(min);
        result.add(max);
        
        return result;
        
    }
}
